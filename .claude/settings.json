{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(bin/serve-docs.sh *)",
      "Bash(bin/start-mssql.sh)",
      "Bash(bin/start-postgres.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list *)",
      "Bash(git worktree list *)",
      "Bash(git remote -v)",
      "Bash(git fetch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(git worktree add *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(gh issue edit *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(mvn *deploy*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)"
    ]
  }
}
